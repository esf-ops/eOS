{
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/api", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/internal/takeoff/process-queued",
      "schedule": "* * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "ignoreCommand": "node ../scripts/vercel-ignore-build.mjs backend-core"
}
