# Copy to .env.local for local Vite (never commit secrets).
# Anon key only — never a service role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_BACKEND_URL=http://localhost:3001
VITE_HOME_URL=http://localhost:5177
# Dev-only: render the labeled fixture without signing in. Ignored in production builds.
VITE_ECC_FIXTURE_PREVIEW=1
