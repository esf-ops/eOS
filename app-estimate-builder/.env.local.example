# Copy to .env.local for local Vite (never commit secrets).
# Anon key only — never a service role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_BACKEND_URL=http://localhost:3001
VITE_HOME_URL=http://localhost:5177
# Dev-only: skip sign-in and price against the local harness (npm run dev:harness → http://127.0.0.1:3091).
# Ignored in production builds. Saving is disabled in this mode.
# VITE_ESTIMATE_BUILDER_PREVIEW=1
# VITE_BACKEND_URL=http://127.0.0.1:3091
