{
  "rewrites": [{ "source": "/((?!assets/).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/team-directory-drbbgub3(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
    },
    {
      "source": "/team-directory-drbbgub3/vcards/(.*)",
      "headers": [{ "key": "Content-Type", "value": "text/vcard; charset=utf-8" }]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "ignoreCommand": "node ../scripts/vercel-ignore-build.mjs app-home"
}
