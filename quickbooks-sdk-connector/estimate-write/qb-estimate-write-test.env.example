# eliteOS QuickBooks Estimate write — TEST ONLY (Phase 1.2 live dry-run)
#
# Copy to C:\eliteOS\config\qb-estimate-write-test.env on the QB VM.
# NEVER point allowlist at the production company.
#
# STEP 1 — discover exact CompanyName (QUERY only):
#   powershell -NoProfile -ExecutionPolicy Bypass -File .\discover-test-company.ps1
#   then set QB_WRITE_TEST_COMPANY_ALLOWLIST to the printed CompanyName EXACTLY.
#
# STEP 2 — live dry-run (still no EstimateAdd transmit):
#   powershell -NoProfile -ExecutionPolicy Bypass -File .\dry-run-estimate-write.ps1
#
# Required:
QB_WRITE_ENABLED=true
QB_WRITE_ENV=test
QB_WRITE_DRY_RUN=true
QB_WRITE_ORGANIZATION_ID=89180433-9fab-4024-bec9-a14d870bd0a8
# REPLACE with exact CompanyName from discover-test-company.ps1 (do not guess):
QB_WRITE_TEST_COMPANY_ALLOWLIST=REPLACE_WITH_EXACT_COMPANYNAME_FROM_DISCOVER
QB_WRITE_FORBIDDEN_COMPANY_IDENTITIES=Elite Stone Fabrications
QB_WRITE_TEST_CUSTOMER_NAME=ELITEOS TEST CUSTOMER

# Supabase (service role — Brain server / operator VM only; never in browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional SDK
# QB_COMPANY_FILE=C:\Path\To\Your-TEST-Company.QBW
# QBXML_VERSION=13.0
# QB_APP_NAME=EliteOS QuickBooks Estimate DryRun

# Filled by dry-run-estimate-write.ps1 after CompanyQuery / CustomerQuery:
# QB_WRITE_COMPANY_IDENTITY=
# QB_WRITE_CUSTOMER_LIST_ID=

# FUTURE real write (DO NOT SET in Phase 1.x):
# QB_WRITE_DRY_RUN=false
# QB_WRITE_TRANSMIT_ADD=1
