# Sales QuickBooks Financial Truth — persistent worker config (EXAMPLE)
# Copy to a path OUTSIDE git, e.g.:
#   C:\eliteOS\config\sales-qb-sync.env
# Scripts run from the eOS working copy on the QB Server, e.g.:
#   C:\Users\Administrator\Documents\GitHub\eOS\quickbooks-sdk-connector\sales-sync
# Do not create a second repo clone at C:\eliteOS for this worker.
# Never commit a file that contains QB_SALES_SYNC_INGEST_TOKEN.
#
# READ-ONLY ODBC DSN only. Separate from Account Directory customer sync (QB_AD_CUSTOMER_*).
# Do NOT set or reuse QB_AD_CUSTOMER_SYNC_INGEST_TOKEN here.

QB_SALES_DSN=slabOS_QuickBooks_Local_RO
QB_SALES_EXPECTED_COMPANY=Elite Stone Fabrications
QB_SALES_ORGANIZATION_ID=
QB_SALES_SYNC_INGEST_URL=https://<brain-host>/api/internal/sales/quickbooks-sync
QB_SALES_SYNC_INGEST_TOKEN=
# Optional (incremental default lookback is 60 days in the worker):
# QB_SALES_SYNC_LOOKBACK_DAYS=60
# QB_SALES_SYNC_CHUNK_SIZE=400
# QB_SALES_SYNC_START_DATE=2024-01-01
# QB_SALES_SYNC_LOG_DIR=C:\eliteOS\logs\sales-qb-sync
# QB_SALES_SYNC_LOCK_DIR=C:\eliteOS\logs\sales-qb-sync
