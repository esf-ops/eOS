# eliteOS QuickBooks Full Finance Foundation — worker env (QB Server)
# Copy to C:\eliteOS\config\finance-qb-sync.env (outside git). Never commit secrets.
#
# Separate from Sales (QB_SALES_*) and Account Directory (QB_AD_CUSTOMER_*).
# Do NOT set or reuse QB_SALES_SYNC_INGEST_TOKEN or QB_AD_CUSTOMER_SYNC_INGEST_TOKEN.

QB_FINANCE_DSN=slabOS_QuickBooks_Local_RO
QB_FINANCE_EXPECTED_COMPANY=Elite Stone Fabrications
QB_FINANCE_ORGANIZATION_ID=
QB_FINANCE_SYNC_INGEST_URL=https://REPLACE_ME/api/internal/finance/quickbooks-sync
QB_FINANCE_SYNC_INGEST_TOKEN=
QB_FINANCE_SYNC_LOOKBACK_DAYS=14
QB_FINANCE_SYNC_CHUNK_SIZE=400
# Leave unset. Phase 1 must not run 2025 historical backfill.
# QB_FINANCE_ALLOW_HISTORICAL_BACKFILL=0
