# eliteOS QuickBooks sales order agent (copy values into the VM's user/task environment;
# do not commit real values).
QB_SO_AGENT_BRAIN_URL=https://api.eliteosfab.com
QB_SO_AGENT_TOKEN=
QB_SO_AGENT_EXPECTED_COMPANY=
# Must be "test" for any write. Production-company writes are not approved.
QB_SO_AGENT_ENVIRONMENT=test
# Default off. Set to 1 only after the TEST write is approved.
QB_SO_AGENT_WRITE_ENABLED=0
# Optional: explicit TEST company file path (recommended, so the production file can't be used by accident)
QB_COMPANY_FILE=
